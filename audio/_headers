# Offex Audio response headers.
#
# NOTE: this project uses an advanced-mode _worker.js, and Cloudflare Pages does
# not apply _headers rules to responses generated by Pages Functions / a
# _worker.js. The authoritative cache policy therefore lives in audio/_worker.js
# (applyCachePolicy). This file is kept as documentation / defence-in-depth and
# covers the cases where the asset server answers directly.

# The app UI page (and its .html form) must never be served stale.
/app-ui
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/app-ui.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# The service worker script itself must always be re-fetched.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Versioned, non-executing static assets are safe to cache hard.
/audio-engine.js
  Cache-Control: public, max-age=604800

/gradio_client.js
  Cache-Control: public, max-age=604800

/styles.css
  Cache-Control: public, max-age=604800

/promo.js
  Cache-Control: public, max-age=604800
